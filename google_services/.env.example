# Variables que esta app necesita. Van en el .env de la raíz `services/`
# (compartido con el resto de apps; NO se versiona). Aquí solo como referencia.
#
# El JSON del service account NO va aquí: va en un archivo aparte, gitignorado,
# cuya ruta se indica en GOOGLE_SA_FILE (relativa a `services/`).

GOOGLE_SA_FILE=google_workspace_sa.json
GOOGLE_ADMIN_DELEGADO=ucgone.users@casagrande.edu.ec
GOOGLE_DOMINIO=casagrande.edu.ec

# Para validar las API keys (PostgreSQL) y el limitador de tasa (Redis). Los datos
# de Google NO se cachean: Redis solo guarda los contadores ratelimit:*. Si Redis
# cae, el servicio sigue (fail-open: sin límite hasta que vuelva).
DATABASE_URL=postgresql://usuario:clave@host:5432/microservices_db
REDIS_URL=redis://localhost:6379/0

# Límite de peticiones por minuto POR API key (commons.rate_limit). Defaults
# razonables; 0 = esa categoría sin límite, RATE_LIMIT_ACTIVO=false lo apaga todo.
# RATE_LIMIT_ACTIVO=true
# RATE_LIMIT_GOOGLE_POR_MINUTO=600    # endpoints que consumen cuota del Admin SDK
# RATE_LIMIT_LECTURA_POR_MINUTO=3000  # lecturas del índice local (PostgreSQL)
